#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node *left, *right;
};

struct Node* createNode(int data) {
    struct Node* newNode =
        (struct Node*)malloc(sizeof(struct Node));

    newNode->data = data;
    newNode->left = newNode->right = NULL;

    return newNode;
}

struct Node* insert(struct Node* root, int data) {
    if (root == NULL)
        return createNode(data);

    if (data < root->data)
        root->left = insert(root->left, data);
    else
        root->right = insert(root->right, data);

    return root;
}

void smallest(struct Node* root, int *found) {
    if (root == NULL || *found)
        return;

    smallest(root->left, found);

    if (!(*found)) {
        printf("Smallest element = %d\n", root->data);
        *found = 1;
        return;
    }

    smallest(root->right, found);
}

int main() {
    struct Node* root = NULL;
    int n, x, found = 0;

    printf("Enter number of nodes: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for (int i = 0; i < n; i++) {
        scanf("%d", &x);
        root = insert(root, x);
    }

    if (root == NULL)
        printf("BST is empty\n");
    else
        smallest(root, &found);

    return 0;
}
